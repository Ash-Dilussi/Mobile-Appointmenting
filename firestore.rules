// firestore.rules
//
// Server-side entitlement enforcement.
// These rules are the security boundary — the client-side FeatureGate is UX only.
//
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isInstitutionMember(institutionId) {
      // User's custom claim must carry their institutionId
      // Set this in your Cloud Function after user creation / institution link.
      return isAuthenticated() &&
             request.auth.token.institutionId == institutionId;
    }

    function isInstitutionOwner(institutionId) {
      return isInstitutionMember(institutionId) &&
             request.auth.token.role == 'owner';
    }

    function getSubscription(institutionId) {
      return get(/databases/$(database)/documents/institutions/$(institutionId)/subscription/plan).data;
    }

    function hasTier(institutionId, requiredTier) {
      let sub = getSubscription(institutionId);
      // Tier hierarchy: enterprise > pro > free
      // 'enterprise' satisfies both 'pro' and 'enterprise' requirements.
      if (requiredTier == 'free') {
        return true; // everyone has free
      }
      if (requiredTier == 'pro') {
        return sub.tier == 'pro' || sub.tier == 'enterprise';
      }
      if (requiredTier == 'enterprise') {
        return sub.tier == 'enterprise';
      }
      return false;
    }

    function isNotExpired(institutionId) {
      let sub = getSubscription(institutionId);
      // If no expiresAt field, treat as non-expiring (lifetime / manual plan)
      return !('expiresAt' in sub) ||
             sub.expiresAt == null ||
             sub.expiresAt > request.time;
    }

    function hasActiveProOrAbove(institutionId) {
      return hasTier(institutionId, 'pro') && isNotExpired(institutionId);
    }

    function hasActiveEnterprise(institutionId) {
      return hasTier(institutionId, 'enterprise') && isNotExpired(institutionId);
    }

    // ── Institution document ───────────────────────────────────────────────

    match /institutions/{institutionId} {
      allow read: if isInstitutionMember(institutionId);
      allow write: if isInstitutionOwner(institutionId);

      // ── Subscription sub-document (read-only for clients) ───────────────
      // Only Cloud Functions (admin SDK) may write to this document.
      // Clients read it to display plan info in the UI.
      match /subscription/plan {
        allow read: if isInstitutionMember(institutionId);
        allow write: if false; // Cloud Function only (admin SDK bypasses rules)
      }

      // ── Call recordings (Pro+ feature) ─────────────────────────────────
      match /recordings/{recordingId} {
        allow read, write: if isInstitutionMember(institutionId)
                           && hasActiveProOrAbove(institutionId);
      }

      // ── Analytics / reports (Pro+ feature) ─────────────────────────────
      match /analytics/{docId} {
        allow read: if isInstitutionMember(institutionId)
                    && hasActiveProOrAbove(institutionId);
        allow write: if false; // Cloud Functions only
      }

      // ── Data exports (Pro+ feature) ─────────────────────────────────────
      match /exports/{exportId} {
        allow create: if isInstitutionMember(institutionId)
                      && hasActiveProOrAbove(institutionId);
        allow read:   if isInstitutionMember(institutionId)
                      && hasActiveProOrAbove(institutionId);
        allow delete: if isInstitutionOwner(institutionId);
        allow update: if false; // immutable once created
      }

      // ── API keys (Enterprise feature) ──────────────────────────────────
      match /apiKeys/{keyId} {
        allow read, write: if isInstitutionOwner(institutionId)
                           && hasActiveEnterprise(institutionId);
      }

      // ── General institution data (free — all members) ───────────────────
      match /callLogs/{logId} {
        allow read, write: if isInstitutionMember(institutionId);
      }

      match /appointments/{apptId} {
        allow read, write: if isInstitutionMember(institutionId);
      }

      // ── Staff members (multiUser is Pro+, but owners can always manage) ─
      match /members/{memberId} {
        allow read:   if isInstitutionMember(institutionId);
        allow create,
              delete: if isInstitutionOwner(institutionId)
                      && hasActiveProOrAbove(institutionId);
        allow update: if isInstitutionOwner(institutionId);
      }
    }

    // ── User profiles ──────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // soft-delete via Cloud Function only
    }
  }
}