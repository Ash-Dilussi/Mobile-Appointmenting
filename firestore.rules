// firestore.rules
//
// Prototype production rules for Bookly's current remote data surface.
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // users/{uid}
    //   uid: string, required, immutable, equals document id
    //   email: string, required, <= 254 characters
    //   displayName: string, required, <= 100 characters
    //   photoUrl: null|string, optional, <= 2048 characters
    //   role: unknown|owner|officer, required, server-controlled
    //   institutionId: string, required, server-controlled
    //   isEmailVerified: bool, required
    //   shouldPromptPasswordChange: bool, required
    //   createdAt: timestamp, required, immutable
    //   updatedAt: timestamp, optional
    //   status: active|pending_leave|left, optional, server-controlled
    //
    // institutions/{institutionId}
    //   id: string, required, immutable, equals document id
    //   ownerId: string, required, immutable
    //   name: string, required, 1..100 characters
    //   themePreset: one of the five supported preset names, required
    //   address: null|string, optional, <= 500 characters
    //   phone: null|string, optional, <= 50 characters
    //   email: null|string, optional, <= 254 characters
    //   logoAsset: null|string, optional, <= 2048 characters
    //   hasEverHadAdditionalStaff: bool, required, server-controlled
    //   createdAt: timestamp, required, immutable
    //   updatedAt: timestamp, required
    //   provisioningMode: atomic-v1, optional, server-controlled
    //   provisioningRequestId: string, optional, server-controlled
    //
    // businessProvisioning/{requestHash}
    //   Server-only idempotency receipt. Clients cannot read or write it.
    //
    // institutions/{institutionId}/subscription/plan
    //   Server-written subscription state; institution members may read it.
    //
    // All other institution subcollections in this file are dormant/future
    // server surfaces. The current mobile app stores operational records in
    // Hive, so client reads and writes are denied until their schemas and sync
    // protocols are implemented and reviewed.
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validString(value, minLength, maxLength) {
      return value is string &&
             value.size() >= minLength &&
             value.size() <= maxLength;
    }

    function validNullableString(data, field, maxLength) {
      return !(field in data) ||
             data[field] == null ||
             validString(data[field], 0, maxLength);
    }

    function validOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validOptionalStatus(data) {
      return !('status' in data) ||
             data.status in ['active', 'pending_leave', 'left'];
    }

    function validEmail(value) {
      return validString(value, 0, 254) &&
             (value == '' ||
              value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    function validNullableEmail(data, field) {
      return !(field in data) ||
             data[field] == null ||
             validEmail(data[field]);
    }

    function validThemePreset(value) {
      return value in [
        'solarOrange',
        'clinicTeal',
        'midnightCharcoal',
        'forestGreen',
        'royalPurple'
      ];
    }

    function isInstitutionMember(institutionId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId == institutionId &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'officer'];
    }

    function isInstitutionOwner(institutionId) {
      return isInstitutionMember(institutionId) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data, userId) {
      return hasOnlyAllowedFields(data, [
               'uid',
               'email',
               'displayName',
               'photoUrl',
               'role',
               'institutionId',
               'isEmailVerified',
               'shouldPromptPasswordChange',
               'createdAt',
               'updatedAt',
               'status'
             ]) &&
             hasRequiredFields(data, [
               'uid',
               'email',
               'displayName',
               'role',
               'institutionId',
               'isEmailVerified',
               'shouldPromptPasswordChange',
               'createdAt'
             ]) &&
             data.uid == userId &&
             validEmail(data.email) &&
             validString(data.displayName, 0, 100) &&
             validNullableString(data, 'photoUrl', 2048) &&
             data.role in ['unknown', 'owner', 'officer'] &&
             validString(data.institutionId, 0, 100) &&
             data.isEmailVerified is bool &&
             data.shouldPromptPasswordChange is bool &&
             data.createdAt is timestamp &&
             validOptionalTimestamp(data, 'updatedAt') &&
             validOptionalStatus(data);
    }

    function isValidInstitution(data, institutionId) {
      return hasOnlyAllowedFields(data, [
               'id',
               'ownerId',
               'name',
               'themePreset',
               'address',
               'phone',
               'email',
               'logoAsset',
               'hasEverHadAdditionalStaff',
               'createdAt',
               'updatedAt',
               'provisioningMode',
               'provisioningRequestId'
             ]) &&
             hasRequiredFields(data, [
               'id',
               'ownerId',
               'name',
               'themePreset',
               'hasEverHadAdditionalStaff',
               'createdAt',
               'updatedAt'
             ]) &&
             data.id == institutionId &&
             validString(data.ownerId, 1, 128) &&
             validString(data.name, 1, 100) &&
             validThemePreset(data.themePreset) &&
             validNullableString(data, 'address', 500) &&
             validNullableString(data, 'phone', 50) &&
             validNullableEmail(data, 'email') &&
             validNullableString(data, 'logoAsset', 2048) &&
             data.hasEverHadAdditionalStaff is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('provisioningMode' in data) ||
              data.provisioningMode == 'atomic-v1') &&
             (!('provisioningRequestId' in data) ||
              validString(data.provisioningRequestId, 64, 64));
    }

    // ===============================================================
    // User Profiles
    // ===============================================================

    match /users/{userId} {
      // User documents contain email and other PII. Never expose one user's
      // complete document to another client.
      allow read: if isOwner(userId);

      // A client may create only its own unlinked skeleton. Owner/officer
      // membership is created exclusively by trusted callable functions.
      allow create: if isOwner(userId) &&
                       uidUnchanged(userId) &&
                       isValidUser(request.resource.data, userId) &&
                       request.resource.data.role == 'unknown' &&
                       request.resource.data.institutionId == '';

      // Self-service profile changes cannot mutate membership, role, status,
      // identity, or the original creation timestamp.
      allow update: if isOwner(userId) &&
                       uidNotModified() &&
                       isValidUser(request.resource.data, userId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'email',
                           'displayName',
                           'photoUrl',
                           'isEmailVerified',
                           'shouldPromptPasswordChange',
                           'updatedAt'
                         ]) &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.institutionId == resource.data.institutionId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.uid == resource.data.uid &&
                       (!('status' in resource.data) ||
                        request.resource.data.status == resource.data.status);

      allow delete: if false;
    }

    // ===============================================================
    // Institution Documents
    // ===============================================================

    match /institutions/{institutionId} {
      allow read: if isInstitutionMember(institutionId) ||
                     (isAuthenticated() && resource.data.ownerId == request.auth.uid);

      // Provisioning and deletion are identity-adjacent operations. Only the
      // Admin SDK callables may perform them.
      allow create, delete: if false;

      allow update: if isInstitutionOwner(institutionId) &&
                       isValidInstitution(request.resource.data, institutionId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'name',
                           'themePreset',
                           'address',
                           'phone',
                           'email',
                           'logoAsset',
                           'updatedAt'
                         ]) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.hasEverHadAdditionalStaff ==
                         resource.data.hasEverHadAdditionalStaff &&
                       (!('provisioningMode' in resource.data) ||
                        request.resource.data.provisioningMode ==
                          resource.data.provisioningMode) &&
                       (!('provisioningRequestId' in resource.data) ||
                        request.resource.data.provisioningRequestId ==
                          resource.data.provisioningRequestId);

      match /subscription/plan {
        allow read: if isInstitutionMember(institutionId);
        allow write: if false;
      }

      match /recordings/{recordingId} {
        allow read, write: if false;
      }

      match /analytics/{docId} {
        allow read, write: if false;
      }

      match /exports/{exportId} {
        allow read, write: if false;
      }

      match /apiKeys/{keyId} {
        allow read, write: if false;
      }

      match /callLogs/{logId} {
        allow read, write: if false;
      }

      match /appointments/{appointmentId} {
        allow read, write: if false;
      }

      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    match /businessProvisioning/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
